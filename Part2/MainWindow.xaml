<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="780" Width="920"
        MinHeight="600" MinWidth="700"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Send button style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="#00D9FF"/>
            <Setter Property="Foreground"   Value="#0D1117"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00B8D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0099BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input textbox style with rounded corners -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background"        Value="#010409"/>
            <Setter Property="Foreground"        Value="#E6EDF3"/>
            <Setter Property="CaretBrush"        Value="#00D9FF"/>
            <Setter Property="BorderBrush"       Value="#30363D"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header  -->
            <RowDefinition Height="8"/>     <!-- Spacer  -->
            <RowDefinition Height="*"/>     <!-- Chat    -->
            <RowDefinition Height="8"/>     <!-- Spacer  -->
            <RowDefinition Height="52"/>    <!-- Input   -->
            <RowDefinition Height="8"/>     <!-- Spacer  -->
            <RowDefinition Height="Auto"/>  <!-- Footer  -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#161B22"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel>

                <!-- ASCII art logo -->
                <TextBlock x:Name="AsciiArtDisplay"
                           FontFamily="Courier New"
                           FontSize="10.5"
                           Foreground="#00FF41"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap"/>

                <!-- Title -->
                <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                           FontFamily="Courier New"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#00D9FF"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                <!-- Subtitle -->
                <TextBlock Text="[ Department of Cybersecurity — South Africa ]"
                           FontFamily="Courier New"
                           FontSize="11"
                           Foreground="#8B949E"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>

                <!-- Author -->
                <TextBlock Text="Created by Sekgatla"
                           FontFamily="Courier New"
                           FontSize="11"
                           Foreground="#3FB950"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>

                <!-- Status bar -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Ellipse Width="8" Height="8"
                             Fill="#00FF41"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                    <TextBlock Text="SYSTEM ONLINE"
                               FontFamily="Courier New"
                               FontSize="10"
                               Foreground="#00FF41"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Chat display ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#161B22"
                CornerRadius="10">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Padding="4,4,4,4">
                <StackPanel x:Name="ChatPanel"
                            Margin="8,4,8,4"/>
            </ScrollViewer>
        </Border>

        <!-- ── Input area ──────────────────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="#161B22"
                CornerRadius="10"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Grid.Column="0"
                         Height="36"
                         Style="{StaticResource InputBoxStyle}"
                         KeyDown="UserInput_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Content="SEND"
                        Height="36"
                        Style="{StaticResource SendButtonStyle}"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="6"
                   Text="Report cybercrime: www.saps.gov.za  |  Emergency: 10111  |  SABRIC: www.sabric.co.za"
                   FontFamily="Courier New"
                   FontSize="10"
                   Foreground="#484F58"
                   HorizontalAlignment="Center"/>

    </Grid>
</Window>
