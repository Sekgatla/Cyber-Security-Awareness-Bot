<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="660" Width="820"
        MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>
        <!-- Send button style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3FB950"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#56D364"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2EA043"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick topic button style -->
        <Style x:Key="QuickButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21262D"/>
                                <Setter Property="BorderBrush" Value="#3FB950"/>
                                <Setter Property="Foreground" Value="#3FB950"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Header with bot name and ASCII art -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Separator -->
            <RowDefinition Height="1"/>
            <!-- Row 2: Chat history area -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Quick topic buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Separator -->
            <RowDefinition Height="1"/>
            <!-- Row 5: Input row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Header ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Background="#161B22" Margin="0" Orientation="Vertical">
            <TextBlock Text="🛡  CyberBot — Cybersecurity Awareness Bot"
                       Foreground="#3FB950"
                       FontWeight="Bold"
                       FontSize="13"
                       Margin="16,10,16,4"/>

            <!-- ASCII Art display -->
            <TextBlock x:Name="AsciiArtBlock"
                       FontFamily="Courier New"
                       FontSize="7.5"
                       Foreground="#238636"
                       Margin="16,0,16,8"
                       xml:space="preserve"/>
        </StackPanel>

        <!-- ── Row 1: Header separator ──────────────────────────────────── -->
        <Rectangle Grid.Row="1" Fill="#30363D"/>

        <!-- ── Row 2: Chat history ───────────────────────────────────────── -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0D1117"
                      Padding="12">
            <TextBlock x:Name="ChatDisplay"
                       TextWrapping="Wrap"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#E6EDF3"
                       LineHeight="20"
                       Padding="0,4,0,4"/>
        </ScrollViewer>

        <!-- ── Row 3: Quick topic buttons ───────────────────────────────── -->
        <Border Grid.Row="3" Background="#161B22" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Passwords"  Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="Phishing"   Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="Privacy"    Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="Scams"      Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="VPN"        Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="Malware"    Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
                <Button Content="Encryption" Style="{StaticResource QuickButtonStyle}" Click="QuickTopic_Click"/>
            </StackPanel>
        </Border>

        <!-- ── Row 4: Input separator ───────────────────────────────────── -->
        <Rectangle Grid.Row="4" Fill="#30363D"/>

        <!-- ── Row 5: Input row ──────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="#161B22" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputBox"
                         Grid.Column="0"
                         Background="#0D1117"
                         Foreground="#E6EDF3"
                         CaretBrush="#3FB950"
                         BorderBrush="#30363D"
                         BorderThickness="1"
                         FontSize="12"
                         FontFamily="Segoe UI"
                         Padding="10,8"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputBox_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource SendButtonStyle}"
                        Click="SendButton_Click"
                        Width="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
