<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot v3.0"
        Height="820" Width="1000"
        MinHeight="650" MinWidth="780"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Tab item style -->
        <Style x:Key="TabStyle" TargetType="TabItem">
            <Setter Property="Background"    Value="#161B22"/>
            <Setter Property="Foreground"    Value="#8B949E"/>
            <Setter Property="FontFamily"    Value="Courier New"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Padding"       Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#161B22" CornerRadius="6,6,0,0"
                                Padding="16,8" Margin="2,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send / action button style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"     Value="#00D9FF"/>
            <Setter Property="Foreground"     Value="#0D1117"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00B8D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0099BB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#484F58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger/delete button style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"     Value="#DA3633"/>
            <Setter Property="Foreground"     Value="#FFFFFF"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success/complete button style -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background"     Value="#238636"/>
            <Setter Property="Foreground"     Value="#FFFFFF"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6B2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text input style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"              Value="#010409"/>
            <Setter Property="Foreground"              Value="#E6EDF3"/>
            <Setter Property="CaretBrush"              Value="#00D9FF"/>
            <Setter Property="BorderBrush"             Value="#30363D"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header       -->
            <RowDefinition Height="8"/>     <!-- Spacer       -->
            <RowDefinition Height="*"/>     <!-- Tabs         -->
            <RowDefinition Height="6"/>     <!-- Spacer       -->
            <RowDefinition Height="Auto"/>  <!-- Footer       -->
        </Grid.RowDefinitions>

        <!-- ── Header ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#161B22" CornerRadius="10" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="AsciiArtDisplay"
                               FontFamily="Courier New" FontSize="9.5"
                               Foreground="#00FF41" HorizontalAlignment="Center"
                               TextWrapping="NoWrap"/>
                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT  v3.0"
                               FontFamily="Courier New" FontSize="13" FontWeight="Bold"
                               Foreground="#00D9FF" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="[ Department of Cybersecurity — South Africa ]"
                               FontFamily="Courier New" FontSize="10"
                               Foreground="#8B949E" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="Created by Sekgatla  ·  PROG6221  ·  IIE University"
                               FontFamily="Courier New" FontSize="10"
                               Foreground="#3FB950" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status indicators -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="8" Height="8" Fill="#00FF41" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="SYSTEM ONLINE" FontFamily="Courier New" FontSize="9" Foreground="#00FF41"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="DbStatusDot" Width="8" Height="8" Fill="#F0883E"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DbStatusText" Text="DB CHECKING"
                                   FontFamily="Courier New" FontSize="9" Foreground="#F0883E"/>
                    </StackPanel>
                    <TextBlock x:Name="UserLabel" Text="User: —"
                               FontFamily="Courier New" FontSize="9" Foreground="#8B949E"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main TabControl ───────────────────────────────────────────── -->
        <TabControl Grid.Row="2"
                    Background="#0D1117"
                    BorderThickness="0"
                    Padding="0">

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 1 — CHAT
            ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="💬  CHAT" Style="{StaticResource TabStyle}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <!-- Chat bubble area -->
                    <Border Grid.Row="0" Background="#161B22" CornerRadius="10">
                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="4">
                            <StackPanel x:Name="ChatPanel" Margin="8,4,8,4"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Input row -->
                    <Border Grid.Row="2" Background="#161B22" CornerRadius="10" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UserInput" Grid.Column="0" Height="34"
                                     Style="{StaticResource InputBox}"
                                     KeyDown="UserInput_KeyDown"/>
                            <Button x:Name="SendButton" Grid.Column="2" Height="34"
                                    Content="SEND" Style="{StaticResource ActionButton}"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 2 — TASK ASSISTANT
            ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="✅  TASKS" Style="{StaticResource TabStyle}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Add task form   -->
                        <RowDefinition Height="10"/>    <!-- Spacer          -->
                        <RowDefinition Height="*"/>     <!-- Task list       -->
                        <RowDefinition Height="8"/>     <!-- Spacer          -->
                        <RowDefinition Height="Auto"/>  <!-- Action buttons  -->
                    </Grid.RowDefinitions>

                    <!-- Add task form -->
                    <Border Grid.Row="0" Background="#161B22" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="ADD A CYBERSECURITY TASK"
                                       FontFamily="Courier New" FontSize="11" FontWeight="Bold"
                                       Foreground="#00D9FF" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Task Title *" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#8B949E" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TaskTitleInput" Height="32"
                                             Style="{StaticResource InputBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Description" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#8B949E" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TaskDescInput" Height="32"
                                             Style="{StaticResource InputBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Reminder (optional)" FontFamily="Segoe UI" FontSize="11"
                                               Foreground="#8B949E" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TaskReminderInput" Height="32"
                                             Style="{StaticResource InputBox}"
                                             Text="e.g. in 7 days / tomorrow"/>
                                </StackPanel>

                                <Button Grid.Column="6" Height="32" Content="ADD TASK"
                                        Style="{StaticResource ActionButton}"
                                        VerticalAlignment="Bottom"
                                        Click="AddTaskButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Task list -->
                    <Border Grid.Row="2" Background="#161B22" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="YOUR TASKS"
                                           FontFamily="Courier New" FontSize="11" FontWeight="Bold"
                                           Foreground="#00D9FF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TaskCountLabel" Text="  (0 tasks)"
                                           FontFamily="Courier New" FontSize="10"
                                           Foreground="#8B949E" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListView x:Name="TaskListView" Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#C9D1D9"
                                      FontFamily="Segoe UI"
                                      FontSize="13"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#"       Width="40"
                                                        DisplayMemberBinding="{Binding Id}"/>
                                        <GridViewColumn Header="Status"  Width="70"
                                                        DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn Header="Title"   Width="220"
                                                        DisplayMemberBinding="{Binding Title}"/>
                                        <GridViewColumn Header="Description" Width="260"
                                                        DisplayMemberBinding="{Binding Description}"/>
                                        <GridViewColumn Header="Reminder" Width="160"
                                                        DisplayMemberBinding="{Binding ReminderDate}"/>
                                        <GridViewColumn Header="Added"   Width="140"
                                                        DisplayMemberBinding="{Binding CreatedAt}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Task action buttons -->
                    <Border Grid.Row="4" Background="#161B22" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✓  MARK AS DONE"   Height="32" Width="140"
                                    Style="{StaticResource SuccessButton}" Margin="0,0,10,0"
                                    Click="MarkDoneButton_Click"/>
                            <Button Content="✕  DELETE TASK"    Height="32" Width="120"
                                    Style="{StaticResource DangerButton}"  Margin="0,0,10,0"
                                    Click="DeleteTaskButton_Click"/>
                            <Button Content="⟳  REFRESH"        Height="32" Width="90"
                                    Style="{StaticResource ActionButton}"
                                    Click="RefreshTasksButton_Click"/>

                            <TextBlock x:Name="TaskStatusMsg" VerticalAlignment="Center"
                                       Margin="16,0,0,0" FontFamily="Segoe UI" FontSize="12"
                                       Foreground="#3FB950"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 3 — QUIZ
            ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="🎮  QUIZ" Style="{StaticResource TabStyle}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Score / controls  -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>     <!-- Question area     -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- Answer buttons    -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>  <!-- Feedback          -->
                    </Grid.RowDefinitions>

                    <!-- Score header -->
                    <Border Grid.Row="0" Background="#161B22" CornerRadius="10" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CYBERSECURITY KNOWLEDGE QUIZ"
                                           FontFamily="Courier New" FontSize="12" FontWeight="Bold"
                                           Foreground="#00D9FF"/>
                                <TextBlock Text="Test your knowledge — multiple choice and true/false questions"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#8B949E" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Score: " FontFamily="Courier New" FontSize="13"
                                           Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScoreLabel" Text="0 / 14"
                                           FontFamily="Courier New" FontSize="14" FontWeight="Bold"
                                           Foreground="#00FF41" VerticalAlignment="Center"
                                           Margin="0,0,20,0"/>
                                <Button Content="▶  START QUIZ" Height="32" Width="120"
                                        Style="{StaticResource ActionButton}"
                                        Click="StartQuizButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Question display -->
                    <Border Grid.Row="2" Background="#161B22" CornerRadius="10" Padding="20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="QuestionNumberLabel"
                                           Text="Press START QUIZ to begin"
                                           FontFamily="Courier New" FontSize="11"
                                           Foreground="#8B949E" Margin="0,0,0,12"/>

                                <TextBlock x:Name="QuestionText"
                                           Text=""
                                           FontFamily="Segoe UI" FontSize="15"
                                           Foreground="#E6EDF3" TextWrapping="Wrap"
                                           LineHeight="24" Margin="0,0,0,16"/>

                                <!-- Progress bar -->
                                <Grid Height="4" Margin="0,0,0,0">
                                    <Border Background="#21262D" CornerRadius="2"/>
                                    <Border x:Name="ProgressBar" Background="#00D9FF"
                                            CornerRadius="2" HorizontalAlignment="Left"
                                            Width="0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Answer buttons -->
                    <Border Grid.Row="4" Background="#161B22" CornerRadius="10" Padding="14,10">
                        <StackPanel x:Name="AnswerPanel">
                            <!-- Multiple choice options — shown/hidden dynamically -->
                            <WrapPanel x:Name="McPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Button x:Name="BtnA" Content="A" Height="40" Width="100"
                                        Style="{StaticResource ActionButton}" Margin="6"
                                        Click="AnswerButton_Click" Tag="A"/>
                                <Button x:Name="BtnB" Content="B" Height="40" Width="100"
                                        Style="{StaticResource ActionButton}" Margin="6"
                                        Click="AnswerButton_Click" Tag="B"/>
                                <Button x:Name="BtnC" Content="C" Height="40" Width="100"
                                        Style="{StaticResource ActionButton}" Margin="6"
                                        Click="AnswerButton_Click" Tag="C"/>
                                <Button x:Name="BtnD" Content="D" Height="40" Width="100"
                                        Style="{StaticResource ActionButton}" Margin="6"
                                        Click="AnswerButton_Click" Tag="D"/>
                            </WrapPanel>

                            <!-- True / False options -->
                            <WrapPanel x:Name="TfPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Button x:Name="BtnTrue" Content="TRUE" Height="40" Width="130"
                                        Style="{StaticResource SuccessButton}" Margin="12"
                                        Click="AnswerButton_Click" Tag="True"/>
                                <Button x:Name="BtnFalse" Content="FALSE" Height="40" Width="130"
                                        Style="{StaticResource DangerButton}" Margin="12"
                                        Click="AnswerButton_Click" Tag="False"/>
                            </WrapPanel>

                            <!-- Start prompt -->
                            <TextBlock x:Name="QuizStartPrompt"
                                       Text="Click START QUIZ above to begin the cybersecurity quiz!"
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#484F58" HorizontalAlignment="Center"
                                       Margin="0,6,0,6"/>
                        </StackPanel>
                    </Border>

                    <!-- Feedback area -->
                    <Border Grid.Row="6" Background="#161B22" CornerRadius="10" Padding="14,10"
                            MinHeight="60">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                            <TextBlock x:Name="QuizFeedback" Text=""
                                       FontFamily="Segoe UI" FontSize="13"
                                       Foreground="#C9D1D9" TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 4 — ACTIVITY LOG
            ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="📋  ACTIVITY LOG" Style="{StaticResource TabStyle}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <Border Grid.Row="0" Background="#161B22" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY LOG"
                                       FontFamily="Courier New" FontSize="12" FontWeight="Bold"
                                       Foreground="#00D9FF"/>
                            <TextBlock Text="A timestamped record of all actions taken by the chatbot this session"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Foreground="#8B949E" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Log entries -->
                    <Border Grid.Row="2" Background="#161B22" CornerRadius="10" Padding="14,12">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogPanel">
                                <TextBlock Text="No activity yet — start chatting, add tasks, or take the quiz!"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="#484F58" Margin="0,4,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Log controls -->
                    <Border Grid.Row="4" Background="#161B22" CornerRadius="10" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⟳  REFRESH LOG" Height="32" Width="130"
                                    Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                                    Click="RefreshLogButton_Click"/>
                            <Button Content="Show Full History" Height="32" Width="140"
                                    Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                                    Click="ShowFullLogButton_Click"/>
                            <TextBlock x:Name="LogCountLabel"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontFamily="Courier New" FontSize="11"
                                       Foreground="#8B949E" Text="0 actions recorded"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── Footer ─────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="4"
                   Text="Report cybercrime: www.saps.gov.za  |  Emergency: 10111  |  SABRIC: www.sabric.co.za"
                   FontFamily="Courier New" FontSize="10"
                   Foreground="#484F58" HorizontalAlignment="Center"/>
    </Grid>
</Window>
